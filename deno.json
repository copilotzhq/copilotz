{
  "name": "@copilotz/copilotz",
  "description": "Copilotz Lib",
  "version": "0.62.1",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./admin": "./plugins/admin/index.ts",
    "./adapters/deno": "./runtime/adapters/deno/index.ts",
    "./application": "./runtime/application/public.ts",
    "./persistence": "./runtime/persistence/index.ts",
    "./collections": "./runtime/collections/index.ts",
    "./channels": "./plugins/channels/index.ts",
    "./core": "./plugins/core/index.ts",
    "./core/cli": "./plugins/core/adapters/index.ts",
    "./core/cli/node": "./plugins/core/adapters/node/index.ts",
    "./content": "./runtime/content/index.ts",
    "./streams": "./runtime/streams/index.ts",
    "./actions": "./runtime/actions/index.ts",
    "./memory": "./plugins/memory/index.ts",
    "./tools": "./plugins/tools/index.ts",
    "./tools/builtin": "./plugins/tools/builtin/plugin.ts",
    "./tools/deno": "./plugins/tools/deno/index.ts",
    "./tools/finance": "./plugins/tools/finance/plugin.ts",
    "./tools/mcp": "./plugins/tools/mcp/generator.ts",
    "./tools/mcp/stdio": "./plugins/tools/mcp/stdio.ts",
    "./tools/openapi": "./plugins/tools/openapi/generator.ts",
    "./tools/persistent-terminal": "./plugins/tools/persistent-terminal/plugin.ts",
    "./tools/persistent-terminal/deno": "./plugins/tools/persistent-terminal/deno.ts",
    "./tools/web": "./plugins/tools/web/plugin.ts",
    "./llm": "./plugins/llm/index.ts",
    "./usage": "./plugins/usage/index.ts",
    "./schedules": "./plugins/schedules/index.ts",
    "./schedules/core": "./plugins/core-schedules/index.ts",
    "./skills": "./plugins/skills/index.ts",
    "./skills/deno": "./plugins/skills/deno.ts",
    "./knowledge": "./plugins/knowledge/index.ts",
    "./goals": "./plugins/goals/index.ts",
    "./events": "./runtime/events/index.ts",
    "./plugins": "./runtime/plugins/index.ts",
    "./migration/v4": "./migration/v4/index.ts",
    "./tokens": "./runtime/tokens/index.ts",
    "./server": "./server/index.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
      "deno.json",
      "index.ts",
      "create-copilotz.ts",
      "plugins/**/*.ts",
      "dependencies/**/*.ts",
      "docs/**/*.md",
      "docs/manifest.json",
      "migration/v4/**/*.ts",
      "runtime/**/*.ts",
      "server/**/*.ts",
      "utils/**/*.ts"
    ],
    "exclude": ["**/*.test.ts", "runtime/testing", "plugins/core/testing"]
  },
  "unstable": [
    "bare-node-builtins",
    "detect-cjs",
    "node-globals",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "net",
    "otel",
    "raw-imports"
  ],
  "imports": {
    "@copilotz/copilotz/admin": "./plugins/admin/index.ts",
    "@copilotz/copilotz/application": "./runtime/application/public.ts",
    "@copilotz/copilotz/persistence": "./runtime/persistence/index.ts",
    "@copilotz/copilotz/collections": "./runtime/collections/index.ts",
    "@copilotz/copilotz/plugins": "./runtime/plugins/index.ts",
    "@copilotz/copilotz/core": "./plugins/core/index.ts",
    "@copilotz/copilotz/core/cli": "./plugins/core/adapters/index.ts",
    "@copilotz/copilotz/core/cli/node": "./plugins/core/adapters/node/index.ts",
    "@copilotz/copilotz/tools": "./plugins/tools/index.ts",
    "@copilotz/copilotz/tools/builtin": "./plugins/tools/builtin/plugin.ts",
    "@copilotz/copilotz/tools/deno": "./plugins/tools/deno/index.ts",
    "@copilotz/copilotz/tools/finance": "./plugins/tools/finance/plugin.ts",
    "@copilotz/copilotz/tools/mcp": "./plugins/tools/mcp/generator.ts",
    "@copilotz/copilotz/tools/mcp/stdio": "./plugins/tools/mcp/stdio.ts",
    "@copilotz/copilotz/tools/openapi": "./plugins/tools/openapi/generator.ts",
    "@copilotz/copilotz/tools/persistent-terminal": "./plugins/tools/persistent-terminal/plugin.ts",
    "@copilotz/copilotz/tools/persistent-terminal/deno": "./plugins/tools/persistent-terminal/deno.ts",
    "@copilotz/copilotz/tools/web": "./plugins/tools/web/plugin.ts",
    "@copilotz/copilotz/llm": "./plugins/llm/index.ts",
    "@copilotz/copilotz/memory": "./plugins/memory/index.ts",
    "@copilotz/copilotz/knowledge": "./plugins/knowledge/index.ts",
    "@copilotz/copilotz/usage": "./plugins/usage/index.ts",
    "@copilotz/copilotz/goals": "./plugins/goals/index.ts",
    "@copilotz/copilotz/schedules": "./plugins/schedules/index.ts",
    "@copilotz/copilotz/schedules/core": "./plugins/core-schedules/index.ts",
    "@copilotz/copilotz/skills": "./plugins/skills/index.ts",
    "@copilotz/copilotz/skills/deno": "./plugins/skills/deno.ts",
    "@copilotz/copilotz/events": "./runtime/events/index.ts",
    "@copilotz/copilotz/actions": "./runtime/actions/index.ts",
    "@copilotz/copilotz/content": "./runtime/content/index.ts",
    "@copilotz/copilotz/streams": "./runtime/streams/index.ts",
    "@copilotz/copilotz/channels": "./plugins/channels/index.ts",
    "@copilotz/copilotz/tokens": "./runtime/tokens/index.ts",
    "@bradenmacdonald/s3-lite-client": "jsr:@bradenmacdonald/s3-lite-client@^0.9.6",
    "@std/assert": "jsr:@std/assert@1",
    "@std/yaml": "jsr:@std/yaml@1"
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@oxian/ominipg", "jsr:@oxian/oxian-js"]
  },
  "tasks": {
    "bundle:runtime-smoke": "deno bundle --platform=browser contracts/runtime/runtime-neutral-smoke.ts --output=dist/runtime-neutral-smoke.mjs",
    "bundle:edge-smoke": "deno bundle --platform=browser contracts/runtime/edge-worker-smoke.ts --output=dist/edge-worker-smoke.mjs",
    "smoke:deno": "deno run contracts/runtime/run-smoke.ts",
    "smoke:node": "node scripts/run-bundled-smoke.mjs",
    "smoke:bun": "bun scripts/run-bundled-smoke.mjs",
    "smoke:browser": "node --experimental-vm-modules scripts/run-isolate-smoke.mjs dist/runtime-neutral-smoke.mjs core",
    "smoke:cloudflare": "node --experimental-vm-modules scripts/run-isolate-smoke.mjs dist/edge-worker-smoke.mjs edge",
    "smoke:cloudflare-build": "npx --yes wrangler@4.120.0 deploy --dry-run --config contracts/runtime/wrangler.jsonc --outdir dist/cloudflare-smoke",
    "check:forbidden": "deno run --allow-read scripts/check-forbidden-symbols.ts",
    "check:boundaries": "deno run --allow-read scripts/check-plugin-boundaries.ts",
    "check:surface": "deno run --allow-read --allow-run=deno scripts/check-package-surface.ts",
    "check": "deno task check:forbidden && deno task check:boundaries && deno task check:surface",
    "publish:dry-run": "deno publish --dry-run --allow-dirty",
    "test": "deno test --allow-all contracts/v3 runtime plugins migration/v4 server utils",
    "test:v3-contracts": "deno task test"
  },
  "lock": false
}
