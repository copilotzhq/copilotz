{
  "name": "@copilotz/copilotz",
  "description": "Copilotz Lib",
  "version": "1.0.0-rc.1",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./assets": "./assets/index.ts",
    "./resources": "./resources/index.ts",
    "./tokens": "./runtime/tokens/index.ts",
    "./server": "./server/index.ts",
    "./migration/v1": "./migration/v1/index.ts",
    "./worker": "./execution/worker-runtime.ts"
  },
  "unstable": [
    "bare-node-builtins",
    "detect-cjs",
    "node-globals",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "net",
    "otel",
    "raw-imports"
  ],
  "imports": {
    "@/": "./",
    "@std/assert": "jsr:@std/assert@1",
    "ajv": "npm:ajv@8.17.1",
    "json-schema-to-ts": "npm:json-schema-to-ts@3.1.1",
    "@oxian/oxian-js/host": "jsr:@oxian/oxian-js@0.20.0-rc.6/host",
    "@oxian/oxian-js/supervisor": "jsr:@oxian/oxian-js@0.20.0-rc.6/supervisor",
    "@oxian/oxian-js/worker": "jsr:@oxian/oxian-js@0.20.0-rc.6/worker",
    "omnipg": "jsr:@oxian/ominipg@0.9.0-rc.1",
    "omnipg/auto": "jsr:@oxian/ominipg@0.9.0-rc.1/auto",
    "omnipg/session": "jsr:@oxian/ominipg@0.9.0-rc.1/session",
    "omnipg/workload": "jsr:@oxian/ominipg@0.9.0-rc.1/workload",
    "ulid": "jsr:@std/ulid@1.0.0"
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@oxian/oxian-js", "jsr:@oxian/ominipg"]
  },
  "tasks": {
    "check": "deno task check:architecture && deno task check:portability && deno task check:dependencies && deno task check:dead-code && deno fmt --check && deno lint && deno check index.ts server/index.ts execution/worker-runtime.ts migration/v1/index.ts",
    "check:architecture": "deno run --allow-read=. scripts/check_v2_architecture.ts",
    "check:portability": "deno run --allow-read=. scripts/check_portability.ts",
    "check:dependencies": "deno run --allow-read=. scripts/check_dependencies.ts",
    "check:dead-code": "deno run --allow-read=. --allow-run=deno scripts/check_dead_code.ts",
    "test": "deno test --allow-all tests",
    "check:publish": "deno publish --dry-run --allow-dirty",
    "verify": "deno task check && deno task test && deno task check:publish"
  },
  "test": {
    "include": ["tests/**/*.test.ts"]
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any", "no-slow-types"]
    }
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "index.ts",
      "engine.ts",
      "assets",
      "attachments",
      "core",
      "database",
      "docs",
      "events",
      "execution",
      "migration",
      "plugins",
      "processors",
      "resources",
      "runtime",
      "server",
      "types"
    ]
  },
  "lock": false
}
