import { definePlugin } from "copilotz";
import plugin from "../../../../plugins/orders/plugin.ts";
import actionOrderShip from "../../../../plugins/orders/actions/order.ship.ts";
import adapterMailLocal from "../../../../plugins/orders/adapters/mail/local.ts";
import collectionOrder from "../../../../plugins/orders/collections/order.ts";
import eventOrderShipped from "../../../../plugins/orders/events/order.shipped.ts";
import processorReceipt from "../../../../plugins/orders/processors/receipt.ts";
import resourceTools from "../../../../plugins/orders/resources/tools.ts";
import routeOrders from "../../../../plugins/orders/routes/orders.ts";
import scheduleDispatch from "../../../../plugins/orders/schedules/dispatch.ts";
import viewToolShipOrder from "../../../../plugins/orders/views/tool/ship_order.ts";

export default definePlugin({
  name: "orders",
  ...plugin,
  actions: {
    "order.ship": actionOrderShip,
  },
  collections: {
    "order": collectionOrder,
  },
  events: {
    "order.shipped": eventOrderShipped,
  },
  processors: {
    "receipt": processorReceipt,
  },
  resources: {
    "tools": resourceTools,
  },
  routes: {
    "/orders": routeOrders,
  },
  schedules: {
    "dispatch": scheduleDispatch,
  },
  views: {
    "tool:ship_order": viewToolShipOrder,
  },
  adapters: {
    "mail": {
      "local": adapterMailLocal,
    },
  },
});
