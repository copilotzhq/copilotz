  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
      "deno.json",
      "index.ts",
      "authoring.ts",
      "worker.ts",
      "create-copilotz.ts",
      "plugins/**/*.ts",
      "plugins/**/*.md",
      "dependencies/**/*.ts",
      "docs/**/*.md",
      "docs/manifest.json",
      "runtime/**/*.ts",
      "server/**/*.ts",
      "client/**/*.ts",
      "build/**/*.ts",
      "plugins/**/copilotz.json",
      "plugins/**/*.tsx",
      "plugins/**/*.css",
      "plugins/ui-kit/katex/LICENSE",
      "plugins/ui-kit/katex/fonts/*.woff2",
      "runtime/migration/**/*.ts"
    ],
    "exclude": [
      "**/*.test.ts",
      "runtime/testing",
      "plugins/core/shared/testing",
      "**/*.test.tsx"
    ]
  },
  "unstable": [
    "no-legacy-abort",
    "bare-node-builtins",
    "detect-cjs",
    "node-globals",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "net",
    "otel",
    "raw-imports"
