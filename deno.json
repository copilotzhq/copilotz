  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@oxian/ominipg",
      "jsr:@oxian/oxian-js",
      "npm:@jsr/oxian__ominipg",
      "npm:@jsr/oxian__oxian-js"
    ]
  },
  "tasks": {
    "bundle:runtime-smoke": "deno bundle --platform=browser contracts/runtime/runtime-neutral-smoke.ts --output=dist/runtime-neutral-smoke.mjs && deno bundle --platform=browser contracts/runtime/skill-root-smoke.ts --output=dist/skill-root-smoke.mjs",
    "bundle:edge-smoke": "deno bundle --platform=browser contracts/runtime/edge-worker-smoke.ts --output=dist/edge-worker-smoke.mjs",
    "smoke:deno": "deno run --allow-read=contracts/runtime/fixtures/skills contracts/runtime/run-smoke.ts",
    "smoke:node": "node scripts/run-bundled-smoke.mjs",
    "smoke:bun": "bun scripts/run-bundled-smoke.mjs",
    "smoke:browser": "node --experimental-vm-modules scripts/run-isolate-smoke.mjs dist/runtime-neutral-smoke.mjs core",
    "smoke:cloudflare": "node --experimental-vm-modules scripts/run-isolate-smoke.mjs dist/edge-worker-smoke.mjs edge",
    "smoke:cloudflare-build": "npx --yes wrangler@4.120.0 deploy --dry-run --config contracts/runtime/wrangler.jsonc --outdir dist/cloudflare-smoke",
    "check:forbidden": "deno run --allow-read scripts/check-forbidden-symbols.ts",
    "check:boundaries": "deno run --allow-read scripts/check-plugin-boundaries.ts",
    "check:plugin-layout": "deno run --allow-read --allow-env scripts/check-plugin-layout.ts",
    "check:surface": "deno run --allow-read --allow-run=deno scripts/check-package-surface.ts",
    "check": "deno task check:forbidden && deno task check:boundaries && deno task check:plugin-layout && deno task check:surface && deno task check:generated && deno task check:core-ownership",
    "publish:dry-run": "deno publish --dry-run --allow-dirty",
    "test": "deno test --node-modules-dir=auto --allow-all contracts/package runtime plugins server client scripts build",
    "test:contracts": "deno test --allow-all contracts/package",
    "build:plugins": "deno run -A scripts/build-plugins.ts",
    "check:generated": "deno run -A scripts/build-plugins.ts --check",
    "smoke:authoring": "deno run -A build/index.ts build contracts/authoring && deno run -A contracts/authoring/run.ts",
    "check:core-ownership": "deno run --allow-read --allow-env scripts/check-core-ownership.ts",
    "build:web-css": "deno run -A --node-modules-dir=auto npm:@tailwindcss/cli@4.1.12 -i plugins/ui-kit/styles.css -o dist/web.css --minify && mkdir -p dist/fonts && cp plugins/ui-kit/katex/fonts/*.woff2 dist/fonts/"
  },
  "lock": false,
  "fmt": {
    "exclude": [
      "**/plugin.generated.ts",
      "plugins/ui-kit/katex/"
    ]
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "nodeModulesDir": "none"
}
