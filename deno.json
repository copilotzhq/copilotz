{
  "name": "@copilotz/copilotz",
  "version": "1.0.0-rc.5",
  "exports": {
    ".": "./runtime/mod.ts",
    "./stores/memory": "./stores/memory/mod.ts",
    "./stores/sqlite": "./stores/sql/sqlite/mod.ts",
    "./stores/postgres": "./stores/sql/postgres/mod.ts",
    "./stores/latency": "./stores/latency/mod.ts",
    "./blobs/files": "./stores/blobs/files/mod.ts",
    "./blobs/http": "./stores/blobs/http/mod.ts",
    "./plugins/models": "./plugins/models/mod.ts",
    "./plugins/agents": "./plugins/agents/mod.ts",
    "./plugins/agents/web": "./plugins/agents/web.tsx",
    "./plugins/agents/terminal": "./plugins/agents/terminal.ts",
    "./plugins/access": "./plugins/access/mod.ts",
    "./plugins/access/web": "./plugins/access/web.tsx",
    "./plugins/access/terminal": "./plugins/access/terminal.ts",
    "./plugins/billing": "./plugins/billing/mod.ts",
    "./plugins/billing/web": "./plugins/billing/usage/web.tsx",
    "./plugins/billing/terminal": "./plugins/billing/terminal.ts",
    "./plugins/compute": "./plugins/compute/mod.ts",
    "./plugins/compute/web": "./plugins/compute/web.tsx",
    "./plugins/compute/terminal": "./plugins/compute/computers/terminal.ts",
    "./plugins/compute/downloads": "./plugins/compute/computers/resources/downloads.ts",
    "./plugins/interfaces": "./plugins/interfaces/mod.ts",
    "./plugins/interfaces/web": "./plugins/interfaces/web.tsx",
    "./plugins/interfaces/terminal": "./plugins/interfaces/terminal/terminal.ts",
    "./web": "./hosts/web/mod.ts",
    "./web/server": "./hosts/web/server.ts",
    "./web/tickets": "./hosts/web/tickets.ts",
    "./web/theme": "./hosts/web/theme/css.ts",
    "./web/node": "./hosts/web/node/mod.ts",
    "./orgs": "./hosts/orgs/mod.ts",
    "./terminal": "./hosts/terminal/mod.ts",
    "./exporters": "./exporters/mod.ts",
    "./testing": "./testing/mod.ts"
  },
  "tasks": {
    "chat": "deno run -A --unstable-no-legacy-abort --env-file=.env examples/terminal-agent/chat.ts",
    "test": "deno test -A --unstable-no-legacy-abort",
    "check": "deno check .",
    "computer": "deno run -A plugins/compute/computers/program/main.ts",
    "executor": "deno run -A --env-file=.env examples/terminal-agent/executor.ts",
    "bench": "deno run -A --unstable-no-legacy-abort examples/terminal-agent/bench.ts",
    "catalog": "deno run --allow-net=models.dev --allow-read=plugins/models/shared/catalog.json --allow-write=plugins/models/shared/catalog.json scripts/catalog.ts",
    "web": "deno run -A --unstable-no-legacy-abort --env-file=.env examples/terminal-agent/web.ts",
    "web:node": "node examples/web-node/server.ts",
    "build:npm": "node scripts/npm/build.ts"
  },
  "imports": {
    "@cfworker/json-schema": "npm:@cfworker/json-schema@4.1.1",
    "croner": "npm:croner@10.0.1",
    "json-schema-to-ts": "npm:json-schema-to-ts@3.1.1",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@oxian/oxian-js": "jsr:@oxian/oxian-js@0.23.2",
    "@oxian/ominipg": "jsr:@oxian/ominipg@0.11.2",
    "react": "npm:react@19.3.1",
    "react/jsx-runtime": "npm:react@19.3.1/jsx-runtime",
    "react-dom": "npm:react-dom@19.3.1",
    "react-dom/client": "npm:react-dom@19.3.1/client",
    "@types/react": "npm:@types/react@19.3.0",
    "@types/react-dom": "npm:@types/react-dom@19.3.0",
    "ink": "npm:ink@8.0.0",
    "@inkjs/ui": "npm:@inkjs/ui@2.0.0",
    "temml": "npm:temml@0.14.0",
    "@xterm/xterm": "npm:@xterm/xterm@6.0.0",
    "@xterm/addon-fit": "npm:@xterm/addon-fit@0.11.0",
    "esbuild": "npm:esbuild@0.28.2"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ]
  },
  "exclude": [
    "dist/"
  ],
  "publish": {
    "exclude": [
      "**/tests/",
      "**/*.test.ts",
      "**/*.test.tsx",
      "examples/",
      "scripts/",
      ".github/",
      "package.json",
      "package-lock.json",
      ".npmrc"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "plugins/models/shared/catalog.json",
      "package-lock.json"
    ]
  },
  "lock": false,
  "nodeModulesDir": "none",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@oxian/oxian-js",
      "jsr:@oxian/ominipg",
      "npm:oxianjs",
      "npm:@jsr/oxian__ominipg",
      "npm:@jsr/oxian__oxian-js"
    ]
  }
}
