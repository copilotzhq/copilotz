{
  "name": "@copilotz/copilotz",
  "description": "Copilotz Lib",
  "version": "0.65.0",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./admin": "./plugins/admin/index.ts",
    "./adapters/deno": "./runtime/adapters/deno/index.ts",
    "./application": "./runtime/application/public.ts",
    "./persistence": "./runtime/persistence/index.ts",
    "./collections": "./runtime/collections/index.ts",
    "./channels": "./plugins/channels/index.ts",
    "./core": "./plugins/core/index.ts",
    "./core/cli": "./plugins/core/adapters/index.ts",
    "./core/cli/node": "./plugins/core/adapters/node-cli/index.ts",
    "./content": "./runtime/content/index.ts",
    "./streams": "./runtime/streams/index.ts",
    "./actions": "./runtime/actions/index.ts",
    "./memory": "./plugins/memory/index.ts",
    "./tools": "./plugins/tools/index.ts",
    "./tools/builtin": "./plugins/tool-builtin/index.ts",
    "./tools/deno": "./plugins/tool-deno/index.ts",
    "./tools/finance": "./plugins/tool-finance/index.ts",
    "./tools/mcp": "./plugins/tool-mcp/index.ts",
    "./tools/mcp/stdio": "./plugins/tool-mcp/adapters/index.ts",
    "./tools/openapi": "./plugins/tool-openapi/index.ts",
    "./tools/persistent-terminal": "./plugins/tool-persistent-terminal/index.ts",
    "./tools/persistent-terminal/deno": "./plugins/tool-persistent-terminal/adapters/index.ts",
    "./tools/web": "./plugins/tool-web/index.ts",
    "./llm": "./plugins/llm/index.ts",
    "./llm/tokens": "./plugins/llm/authoring/token-estimation/index.ts",
    "./usage": "./plugins/usage/index.ts",
    "./schedules": "./plugins/schedules/index.ts",
    "./schedules/core": "./plugins/schedule-core/index.ts",
    "./skills": "./plugins/skills/index.ts",
    "./skills/deno": "./plugins/skills/authoring/open-skills/index.ts",
    "./knowledge": "./plugins/knowledge/index.ts",
    "./goals": "./plugins/core/authoring/goals/index.ts",
    "./events": "./runtime/events/index.ts",
    "./plugins": "./runtime/plugins/index.ts",
    "./migration/v4": "./migration/v4/index.ts",
    "./server": "./server/index.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
      "deno.json",
      "index.ts",
      "create-copilotz.ts",
      "plugins/**/*.ts",
      "plugins/**/*.md",
      "dependencies/**/*.ts",
      "docs/**/*.md",
      "docs/manifest.json",
      "migration/v4/**/*.ts",
      "runtime/**/*.ts",
      "server/**/*.ts"
    ],
    "exclude": [
      "**/*.test.ts",
      "runtime/testing",
      "plugins/core/internal/testing"
    ]
  },
  "unstable": [
    "bare-node-builtins",
    "detect-cjs",
    "node-globals",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "net",
    "otel",
    "raw-imports"
  ],
  "imports": {
    "@copilotz/copilotz": "./index.ts",
    "@copilotz/copilotz/admin": "./plugins/admin/index.ts",
    "@copilotz/copilotz/adapters/deno": "./runtime/adapters/deno/index.ts",
    "@copilotz/copilotz/application": "./runtime/application/public.ts",
    "@copilotz/copilotz/persistence": "./runtime/persistence/index.ts",
    "@copilotz/copilotz/collections": "./runtime/collections/index.ts",
    "@copilotz/copilotz/channels": "./plugins/channels/index.ts",
    "@copilotz/copilotz/core": "./plugins/core/index.ts",
    "@copilotz/copilotz/core/cli": "./plugins/core/adapters/index.ts",
    "@copilotz/copilotz/core/cli/node": "./plugins/core/adapters/node-cli/index.ts",
    "@copilotz/copilotz/content": "./runtime/content/index.ts",
    "@copilotz/copilotz/streams": "./runtime/streams/index.ts",
    "@copilotz/copilotz/actions": "./runtime/actions/index.ts",
    "@copilotz/copilotz/memory": "./plugins/memory/index.ts",
    "@copilotz/copilotz/tools": "./plugins/tools/index.ts",
    "@copilotz/copilotz/tools/builtin": "./plugins/tool-builtin/index.ts",
    "@copilotz/copilotz/tools/deno": "./plugins/tool-deno/index.ts",
    "@copilotz/copilotz/tools/finance": "./plugins/tool-finance/index.ts",
    "@copilotz/copilotz/tools/mcp": "./plugins/tool-mcp/index.ts",
    "@copilotz/copilotz/tools/mcp/stdio": "./plugins/tool-mcp/adapters/index.ts",
    "@copilotz/copilotz/tools/openapi": "./plugins/tool-openapi/index.ts",
    "@copilotz/copilotz/tools/persistent-terminal": "./plugins/tool-persistent-terminal/index.ts",
    "@copilotz/copilotz/tools/persistent-terminal/deno": "./plugins/tool-persistent-terminal/adapters/index.ts",
    "@copilotz/copilotz/tools/web": "./plugins/tool-web/index.ts",
    "@copilotz/copilotz/llm": "./plugins/llm/index.ts",
    "@copilotz/copilotz/llm/tokens": "./plugins/llm/authoring/token-estimation/index.ts",
    "@copilotz/copilotz/usage": "./plugins/usage/index.ts",
    "@copilotz/copilotz/schedules": "./plugins/schedules/index.ts",
    "@copilotz/copilotz/schedules/core": "./plugins/schedule-core/index.ts",
    "@copilotz/copilotz/skills": "./plugins/skills/index.ts",
    "@copilotz/copilotz/skills/deno": "./plugins/skills/authoring/open-skills/index.ts",
    "@copilotz/copilotz/knowledge": "./plugins/knowledge/index.ts",
    "@copilotz/copilotz/goals": "./plugins/core/authoring/goals/index.ts",
    "@copilotz/copilotz/events": "./runtime/events/index.ts",
    "@copilotz/copilotz/plugins": "./runtime/plugins/index.ts",
    "@copilotz/copilotz/migration/v4": "./migration/v4/index.ts",
    "@copilotz/copilotz/server": "./server/index.ts",
    "@bradenmacdonald/s3-lite-client": "jsr:@bradenmacdonald/s3-lite-client@^0.9.6",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@1.29.0",
    "@oxian/ominipg": "jsr:@oxian/ominipg@0.9.0-rc.11",
    "@oxian/oxian-js": "jsr:@oxian/oxian-js@0.21.1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/ulid": "jsr:@std/ulid@1.0.0",
    "@std/yaml": "jsr:@std/yaml@1",
    "ajv": "npm:ajv@^8.17.1",
    "ajv-formats": "npm:ajv-formats@^3.0.1",
    "croner": "npm:croner@9.0.0",
    "jq-wasm": "npm:jq-wasm@3.0.0-jq-1.8.2",
    "json-schema-to-ts": "npm:json-schema-to-ts@3.1.1",
    "yaml": "npm:yaml@2.8.0",
    "zod": "npm:zod@3.25.76"
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@oxian/ominipg",
      "jsr:@oxian/oxian-js"
    ]
  },
  "tasks": {
    "bundle:runtime-smoke": "deno bundle --platform=browser contracts/runtime/runtime-neutral-smoke.ts --output=dist/runtime-neutral-smoke.mjs",
    "bundle:edge-smoke": "deno bundle --platform=browser contracts/runtime/edge-worker-smoke.ts --output=dist/edge-worker-smoke.mjs",
    "smoke:deno": "deno run contracts/runtime/run-smoke.ts",
    "smoke:node": "node scripts/run-bundled-smoke.mjs",
    "smoke:bun": "bun scripts/run-bundled-smoke.mjs",
    "smoke:browser": "node --experimental-vm-modules scripts/run-isolate-smoke.mjs dist/runtime-neutral-smoke.mjs core",
    "smoke:cloudflare": "node --experimental-vm-modules scripts/run-isolate-smoke.mjs dist/edge-worker-smoke.mjs edge",
    "smoke:cloudflare-build": "npx --yes wrangler@4.120.0 deploy --dry-run --config contracts/runtime/wrangler.jsonc --outdir dist/cloudflare-smoke",
    "check:forbidden": "deno run --allow-read scripts/check-forbidden-symbols.ts",
    "check:boundaries": "deno run --allow-read scripts/check-plugin-boundaries.ts",
    "check:plugin-layout": "deno run --allow-read scripts/check-plugin-layout.ts",
    "check:surface": "deno run --allow-read --allow-run=deno scripts/check-package-surface.ts",
    "check": "deno task check:forbidden && deno task check:boundaries && deno task check:plugin-layout && deno task check:surface",
    "publish:dry-run": "deno publish --dry-run --allow-dirty",
    "test": "deno test --allow-all contracts/package runtime plugins migration/v4 server scripts",
    "test:contracts": "deno test --allow-all contracts/package"
  },
  "lock": false
}
