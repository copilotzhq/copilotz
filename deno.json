{
  "name": "@copilotz/copilotz",
  "version": "1.0.0-rc.1",
  "exports": "./runtime/mod.ts",
  "tasks": {
    "chat": "deno run -A --unstable-no-legacy-abort --env-file=.env examples/terminal-agent/chat.ts",
    "test": "deno test -A --unstable-no-legacy-abort",
    "check": "deno check scripts/catalog.ts runtime/mod.ts stores/memory/mod.ts stores/sql/postgres/mod.ts plugins/models/mod.ts plugins/agents/mod.ts plugins/billing/mod.ts plugins/access/mod.ts plugins/access/terminal.ts exporters/mod.ts hosts/terminal/mod.ts plugins/agents/terminal.ts plugins/billing/terminal.ts plugins/interfaces/terminal/terminal.ts examples/terminal-agent/chat.ts examples/terminal-agent/executor.ts examples/terminal-agent/bench.ts examples/terminal-agent/web.ts examples/terminal-agent/browser.tsx examples/terminal-agent/harbor.tsx plugins/compute/computers/program/main.ts",
    "computer": "deno run -A plugins/compute/computers/program/main.ts",
    "executor": "deno run -A --env-file=.env examples/terminal-agent/executor.ts",
    "bench": "deno run -A --unstable-no-legacy-abort examples/terminal-agent/bench.ts",
    "catalog": "deno run --allow-net=models.dev --allow-read=plugins/models/shared/catalog.json --allow-write=plugins/models/shared/catalog.json scripts/catalog.ts",
    "web": "deno run -A --unstable-no-legacy-abort --env-file=.env examples/terminal-agent/web.ts"
  },
  "imports": {
    "@cfworker/json-schema": "npm:@cfworker/json-schema@4.1.1",
    "croner": "npm:croner@10.0.1",
    "json-schema-to-ts": "npm:json-schema-to-ts@3.1.1",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@oxian/oxian-js": "jsr:@oxian/oxian-js@0.23.2",
    "@oxian/ominipg": "jsr:@oxian/ominipg@0.11.2",
    "react": "npm:react@19.3.1",
    "react/jsx-runtime": "npm:react@19.3.1/jsx-runtime",
    "react-dom": "npm:react-dom@19.3.1",
    "react-dom/client": "npm:react-dom@19.3.1/client",
    "@types/react": "npm:@types/react@19.3.0",
    "@types/react-dom": "npm:@types/react-dom@19.3.0",
    "ink": "npm:ink@8.0.0",
    "@inkjs/ui": "npm:@inkjs/ui@2.0.0",
    "temml": "npm:temml@0.14.0",
    "@xterm/xterm": "npm:@xterm/xterm@6.0.0",
    "@xterm/addon-fit": "npm:@xterm/addon-fit@0.11.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "plugins/models/shared/catalog.json",
      "package-lock.json"
    ]
  },
  "lock": false,
  "nodeModulesDir": "none",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@oxian/oxian-js",
      "jsr:@oxian/ominipg",
      "npm:oxianjs",
      "npm:@jsr/oxian__ominipg",
      "npm:@jsr/oxian__oxian-js"
    ]
  }
}
